.claude/settings.local.json

# Dev-only project notes for Claude Code - not meant to be public
CLAUDE.md

# Kevin's personal local-dev launcher (assumes a "venv" folder next to it)
Launch Track Tidy.bat

# Personal build/packaging tooling - useful only on Kevin's own build
# machine, not needed to read/understand the source (GPL compliance
# only requires the source itself, not the build scripts). build_mac.sh
# is the one exception - the build-macos.yml GitHub Actions workflow
# checks out the repo fresh and needs it to actually exist there.
build_all.bat
build_exe.bat
installer.iss
Track-Tidy.spec

# Python
__pycache__/
*.pyc
venv/
venv_build/

# Build artifacts
build/
dist/
installer_output/

# Large binaries / bundled tools
ffmpeg.exe
fpcalc.exe

# Audio test/sample files (but NOT the two app assets used as UI sound
